# ==============================================================================
# Aegis ContractLock - Environment Configuration Template (.env.example)
# ==============================================================================
# CORE RUNTIME NOTICE:
# Core Aegis ContractLock is entirely self-contained, deterministic, and offline.
# The verification engine, legacy reference, modern candidate, and contract tests
# require NO runtime secrets, API keys, database credentials, or external tokens.
#
# DO NOT INVENT OR COMMIT SECRETS:
# Real credentials, passwords, private keys, and cloud API tokens must NEVER be
# committed to this repository. The active `.env` file is excluded from git and
# IBM Bob indexing via .gitignore and .bobignore.
#
# FUTURE INTEGRATIONS:
# If optional future integrations (e.g., external telemetry, remote webhooks, or
# cloud artifact storage) are added in extended workflows, document placeholder
# variable names here using safe dummy values (e.g., YOUR_KEY_HERE).
# Do not configure live production or personal secrets in this template.
# ==============================================================================

# Core Execution Environment
AEGIS_ENV=local
AEGIS_LOG_LEVEL=INFO

# Future Integration Placeholders (Examples only - not required for core Aegis)
# AEGIS_INTEGRATION_ENDPOINT=https://api.example.com/v1
# AEGIS_INTEGRATION_API_KEY=PLACEHOLDER_DO_NOT_COMMIT_REAL_KEYS
